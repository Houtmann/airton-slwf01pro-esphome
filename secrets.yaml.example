# Copiez ce fichier en secrets.yaml et renseignez vos propres valeurs.
# secrets.yaml est ignoré par git : vos identifiants ne partiront jamais
# sur GitHub.

wifi_ssid: "NOM_DE_VOTRE_RESEAU"
wifi_password: "VOTRE_MOT_DE_PASSE_WIFI"

# Mot de passe du point d'accès de secours créé par le module lorsqu'il
# n'arrive pas à rejoindre votre Wi-Fi. Au moins 8 caractères.
ap_password: "MOT_DE_PASSE_DE_SECOURS"
